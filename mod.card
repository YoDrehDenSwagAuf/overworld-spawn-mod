-- never by the loader's merge.
return {
  summary = "Visible wild Pokemon in the overworld; touch one to battle that species. Does not change the player spawn.",
  author = "overworld-spawn-mod",
  contact = "https://github.com/YoDrehDenSwagAuf/overworld-spawn-mod",
  tags = { "overworld", "encounters", "gameplay", "voxel-compatible", "diagnostics" },
  differences = {
    changed = {
      "maps with grass encounter tables can also show tangible wild Pokemon",
      "vanilla grass rolls are suppressed only after visible spawns initialize successfully",
    },
    added = {
      "data-driven overworld wild Pokemon entities on grass cells",
      "fail-safe that keeps classic grass encounters if the spawn system is not ready",
      "collision/step trigger that starts BattleState.newWild for the spawn",
      "dual-mode rendering: SpriteRenderer 2D cards and optional VoxelScene billboards",
      "Mod Manager option: Show wild Pokemon in the overworld",
      "Developer mode with spawn debug HUD, Pokemon preview browser, and phased test spawn",
      "debug_logging and force_test_spawn options for diagnosis",
    },
    known = {
      "species art prefers the player's decoded battle front pics baked to 16x16; "
