-- Sharing metadata. Read by tooling and the manager detail pane;
-- never by the loader's merge.
return {
  summary = "Visible wild Pokémon in the overworld; touch one to battle that species. Does not change the player spawn.",
  author = "overworld-spawn-mod",
  contact = "https://github.com/YoDrehDenSwagAuf/overworld-spawn-mod",
  tags = { "overworld", "encounters", "gameplay", "voxel-compatible" },
  differences = {
    changed = {
      "maps with grass encounter tables can also show tangible wild Pokémon",
      "optional suppression of vanilla random grass rolls while visible spawns are on",
    },
    added = {
      "data-driven overworld wild Pokémon entities on grass cells",
      "collision/step trigger that starts BattleState.newWild for the spawn",
      "dual-mode rendering: SpriteRenderer 2D cards and VoxelScene billboards",
      "Mod Manager option: Show wild Pokémon in the overworld",
    },
    known = {
      "species art prefers the player's decoded battle front pics baked to 16x16; "
        .. "otherwise a bundled placeholder silhouette is used",
      "spawns are runtime-only and reset when you leave and re-enter a map",
      "only grass encounter areas are supported in 0.1.0 (not water/cave tables yet)",
      "Dramatic Shape overworld battles cull non-player entities from the arena shot",
      "vanilla grass rolls are suppressed via the public encounter.roll hook when enabled; "
        .. "fishing, surf, static, scripted, and trainer encounters are untouched",
    },
  },
  credits = {
    { who = "bryanthaboi/gen1recomp", for_ = "mod API, encounter tables, WorldAPI" },
    { who = "DramaticShape/DramaticShapeVoxelMod",
      for_ = "entity pose()/draw() dual-mode rendering contract" },
  },
  compat = { engine = "0.0.0-dev || >=0.1.0 <2.0.0", modApi = 2 },
}
